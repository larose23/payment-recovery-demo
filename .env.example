# Stripe (use TEST mode keys: they start with sk_test_)
STRIPE_SECRET_KEY=sk_test_...
# Signing secret from the Stripe webhook you create (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_...
# Resend API key (starts with re_)
RESEND_API_KEY=re_...
# Sender address. Leave as is until you verify a domain in Resend.
EMAIL_FROM=Payment Recovery Demo <onboarding@resend.dev>
# Any long random string. Vercel sends it to the daily reminder job.
CRON_SECRET=change-me
# Length of one "day" in seconds. 86400 = real days. 60 = one minute per day for demos.
RECOVERY_DAY_SECONDS=60
# Address that receives the demo emails (must be your Resend account email until you verify a domain)
DEMO_EMAIL=you@example.com
